# Firebase project used for auth only (media plans live in Postgres) — the console's own
# sign-in issues ID tokens against this project. Reuses VisionPlayBackend's Firebase project
# since the frontend is shared: currently "justbaat-apps" (its "debug"/staging alias).
# For standalone hosting (src/server.ts, e.g. PM2), also place a matching
# <GCLOUD_PROJECT>-firebase-adminsdk.json service account file at the project root
# (gitignored) — copy it from VisionPlayBackend. Not needed when deployed as a real
# Firebase Function (src/functions/*), which resolves credentials automatically.
GCLOUD_PROJECT=justbaat-apps

# Same Postgres instance/URL VisionPlayBackend uses — copy the value from its .env.
# This backend only touches its own `media_plans` table there.
DATABASE_URL='postgresql://user:password@host:5432/dbname'

# Bedrock credentials — either a bearer-token API key (preferred; same one the org's
# audience-estimate feature uses) or, if unset, the standard AWS SigV4 chain
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, or an IAM role when deployed).
AWS_REGION=us-east-1
BEDROCK_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock model id (or cross-region inference profile id) for Claude. Must be enabled
# in your AWS account/region — check the Bedrock console's "Model access" page.
BEDROCK_MODEL_ID=anthropic.claude-opus-5

CORS_ALLOWED_ORIGINS=*

# Flat markup (%) added on top of every rate-card CPM the planner quotes; the gap is our commission.
PLANNER_MARGIN_PERCENT=10
